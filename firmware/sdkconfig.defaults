# Roomie Beacon: only what a room beacon needs.

# Bluetooth LE only, with the small NimBLE stack. Wi-Fi is never started or linked.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_EXT_ADV=n
CONFIG_BT_NIMBLE_LOG_LEVEL_NONE=y

# Lowest CPU speed Bluetooth runs at (per-chip files override where a chip differs).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y

# Quiet: only warnings.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# Fits every board.
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
